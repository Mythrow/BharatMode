{
  "name": "bharat-mode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.jsx",
    "validate": "node scripts/validate-stories.mjs",
    "voice": "node scripts/tts-openai.mjs",
    "render:sample": "remotion render src/index.jsx BharatShort out/param-rudra.mp4 --props=stories/param-rudra.json --codec=h264",
    "render:icmr": "remotion render src/index.jsx BharatShort out/icmr-tech-transfer.mp4 --props=stories/icmr-tech-transfer.json --codec=h264",
    "audio:generate": "node scripts/make-audio.mjs",
    "variety:check": "node scripts/check-variety.mjs",
    "thumbnail:sample": "remotion still src/index.jsx BharatThumbnail out/param-rudra-thumb.png --props=stories/param-rudra.json",
    "thumbnail:icmr": "remotion still src/index.jsx BharatThumbnail out/icmr-tech-transfer-thumb.png --props=stories/icmr-tech-transfer.json",
    "brand:check": "node scripts/check-brand.mjs",
    "logo:check": "node scripts/check-logo-assets.mjs",
    "cover:check": "node scripts/check-channel-cover.mjs",
    "styleproof:ivory": "remotion still src/index.jsx BharatProofIvory out/styleproof-ivory.png",
    "styleproof:dark": "remotion still src/index.jsx BharatProofDark out/styleproof-dark.png",
    "styleproof:saffron": "remotion still src/index.jsx BharatProofSaffron out/styleproof-saffron.png",
    "motion:preview": "remotion render src/index.jsx BharatMotionPreviewV6 out/bharat-motion-preview-v6.mp4 --codec=h264",
    "chapters:check": "node scripts/test-chapters.mjs",
    "motion:preview:v1": "remotion render src/index.jsx BharatMotionPreview out/bharat-motion-preview.mp4 --codec=h264",
    "motion:timing:check": "node scripts/test-motion-v2-timing.mjs",
    "motion:preview:v2": "remotion render src/index.jsx BharatMotionPreviewV2 out/bharat-motion-preview-v2.mp4 --codec=h264",
    "motion:timing:check:v3": "node scripts/test-motion-v3-timing.mjs",
    "motion:html:v3": "python3 scripts/build-motion-v3-html.py",
    "motion:preview:v3": "remotion render src/index.jsx BharatMotionPreviewV3 out/bharat-motion-preview-v3.mp4 --codec=h264",
    "motion:timing:check:v4": "node scripts/test-motion-v4-timing.mjs",
    "motion:preview:v4": "remotion render src/index.jsx BharatMotionPreviewV4 out/bharat-motion-preview-v4.mp4 --codec=h264",
    "motion:timing:check:v5": "node scripts/test-motion-v5-timing.mjs",
    "motion:html:v5": "python3 scripts/build-motion-v5-html.py",
    "motion:preview:v5": "remotion render src/index.jsx BharatMotionPreviewV5 out/bharat-motion-preview-v5.mp4 --codec=h264",
    "motion:timing:check:v6": "node scripts/test-motion-v6-timing.mjs",
    "template:check": "node scripts/test-approved-template.mjs",
    "voice:reference:test": "python scripts/test_qwen_reference.py",
    "alignment:check": "python -m unittest discover -s scripts -p test_align_qwen_words.py && node scripts/test-aligned-caption-timing.mjs",
    "voice:base:qa:test": "python -m unittest discover -s scripts -p 'test_validate_qwen_base_output.py'",
    "content:check": "node scripts/content-registry.mjs check",
    "content:test": "node scripts/test-content-registry.mjs",
    "content:sync": "node scripts/content-registry.mjs sync",
    "content:list": "node scripts/content-registry.mjs list",
    "content:find": "node scripts/content-registry.mjs find",
    "content:add": "node scripts/content-registry.mjs add",
    "content:move": "node scripts/content-registry.mjs move",
    "music:auditions": "python scripts/generate_music_auditions.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.545"
  }
}
